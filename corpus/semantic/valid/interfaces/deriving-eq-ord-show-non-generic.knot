-- expect: a non-generic ADT can derive Eq/Ord/Show automatically via a
-- `deriving (...)` clause, with no hand-written instance body -- every
-- field (Float) is a concrete builtin type that already has all three.
type Shape
  = Circle Float
  | Rectangle Float Float
  deriving (Eq, Ord, Show)

sameShape :: Shape -> Shape -> Bool
sameShape a b = a == b

orderShapes :: Shape -> Shape -> Bool
orderShapes a b = a < b

describeShape :: Shape -> String
describeShape s = show s
