-- KNOWN GAP, not a discovery: exhaustiveness.rs implements real,
-- Maranget's-algorithm pattern-match usefulness checking and is fully
-- tested standalone, but check_module never calls it. This `area`
-- function's own `case` handles Circle and Square but silently omits
-- Triangle entirely -- a real program calling `area (Triangle 3 4 5)`
-- would have no defined behavior at all, yet this currently type-checks
-- with zero diagnostics, not even a warning. See checker_impl_summary.md's
-- own "Known gaps" section. Expected once this is wired in: at least a
-- warning (the language spec only ever asks for one here, not a hard
-- error) naming the missing Triangle arm.
type Shape
    = Circle Float
    | Square Float
    | Triangle Float Float Float

area :: Shape -> Float
area shape = case shape of
  Circle r -> 3.14159 * r * r
  Square s -> s * s
