-- KNOWN GAP, not a discovery: a real, demonstrated *unsoundness*, not
-- just an incompleteness. `interface::instance::instance_requires` only
-- ever populates `requires` for a `CType::Named` target -- a
-- `CType::Record` target's own declared context (`Eq a =>`) is silently
-- dropped, never attached to the record's own InstanceTable entry. The
-- effect: `check_instance` confirms `Eq { value : a }`'s own shape has an
-- instance without ever re-checking that `a`'s own actual argument type
-- (NoEqType below, which has no Eq instance at all) really satisfies the
-- `Eq a` this instance's own body depends on. `badCompare` calls `==` on
-- two `{ value : NoEqType }` records and currently type-checks with zero
-- errors. See checker_impl_summary.md's own "Known gaps" section.
-- Expected once fixed: a NoInstance("Eq") error, since NoEqType itself
-- has no Eq instance.
type NoEqType = NoEqType Float

instance Eq a => Eq { value : a } where
  (==) x y = x.value == y.value

badCompare :: { value : NoEqType } -> { value : NoEqType } -> Bool
badCompare x y = x == y
