-- KNOWN GAP, not a discovery: this session added a real path for closed
-- *record* instance targets (InstanceTable's own RecordKey-keyed
-- record_entries), but a Tuple target still has no equivalent -- head_ref
-- returns None for CType::Tuple and there is no tuple analog of
-- record_key, so this is still InstanceTargetNotNominal even though the
-- exact same shape of declaration now works for a record. Tuple still
-- gets automatic structural Eq/Ord/Show (unaffected either way); this is
-- specifically about a *custom* instance, or any interface with no
-- structural fallback at all. See checker_impl_summary.md's own "Known
-- gaps" section. Expected once fixed: this instance is accepted, and
-- `describePair` type-checks by calling it.
instance Show (Int, Int) where
  show pair = case pair of
    (a, b) -> "(" <> show a <> ", " <> show b <> ")"

describePair :: (Int, Int) -> String
describePair pair = show pair
