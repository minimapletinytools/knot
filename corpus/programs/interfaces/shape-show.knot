type Shape
    = Circle Float
    | Rectangle Float Float
    | Triangle Float Float Float

instance Show Shape where
  show s = case s of
    Circle r -> "Circle(radius=" <> show r <> ")"
    Rectangle w h -> "Rectangle(" <> show w <> "x" <> show h <> ")"
    Triangle a b c -> "Triangle(" <> show a <> "," <> show b <> "," <> show c <> ")"

describeAll :: List Shape -> List String
describeAll shapes = map show shapes
