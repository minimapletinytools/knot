type Tree a
    = Leaf
    | Node (Tree a) a (Tree a)

insert :: Ord a => a -> Tree a -> Tree a
insert x t = case t of
  Leaf -> Node Leaf x Leaf
  Node l y r ->
    if x < y then
      Node (insert x l) y r
    else if x > y then
      Node l y (insert x r)
    else
      t

contains :: Ord a => a -> Tree a -> Bool
contains x t = case t of
  Leaf -> False
  Node l y r ->
    if x == y then
      True
    else if x < y then
      contains x l
    else
      contains x r

size :: Tree a -> Int
size t = case t of
  Leaf -> 0
  Node l _ r -> 1 + size l + size r

fromList :: Ord a => List a -> Tree a
fromList xs = foldl (\t x -> insert x t) Leaf xs
