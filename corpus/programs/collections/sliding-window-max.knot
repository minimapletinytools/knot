takeN :: Int -> List Int -> List Int
takeN n xs =
  if n <= 0 then
    []
  else
    case xs of
      [] -> []
      h : t -> h : takeN (n - 1) t

windowsOf :: Int -> List Int -> List (List Int)
windowsOf size xs =
  if length xs < size then
    []
  else
    case xs of
      [] -> []
      _ : rest -> takeN size xs : windowsOf size rest

maxOfList :: List Int -> Int
maxOfList xs = case xs of
  [] -> 0
  h : t -> foldl (\acc x -> if x > acc then x else acc) h t

slidingWindowMax :: Int -> List Int -> List Int
slidingWindowMax size xs = map maxOfList (windowsOf size xs)

sampleWindowMaxes :: List Int
sampleWindowMaxes = slidingWindowMax 3 [1, 3, 2, 5, 4, 6]
