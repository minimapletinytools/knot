
type alias Id = String

-- The absolute minimum: something that *can* carry a manually-assigned id,
-- nothing else assumed. Satisfied by every shape below (they all satisfy
-- the strictly bigger IsGraphicsElement too) as well as by Group.
type alias IsElement a = { a | id : Maybe Id }

-- The closed field bundle every graphics-element-shaped type has. Kept as
-- its own alias (rather than only existing as the open IsGraphicsElement
-- constraint below) specifically so `..GraphicsElement` has something
-- concrete to spread — see the "Primitive shapes" section.
--
-- Inheritance (via Group) note: every field below that's a real inherited
-- SVG presentation property is `Maybe` — `Nothing` means "resolve from the
-- nearest ancestor Group that sets it," a genuinely different state from
-- any concrete value (e.g. `Nothing` on `fill` is not the same as
-- `Just NoPaint`, which explicitly opts out of inheriting). `opacity` and
-- `transform` are deliberately *not* in this group despite looking similar:
-- `opacity` is non-inherited in SVG (it composites the element's own
-- rendered subtree at that alpha, rather than each descendant resolving its
-- own opacity from an ancestor), and `transform` doesn't inherit at all --
-- it composes/accumulates down the tree regardless of whether any given
-- element sets one, which is a job for whatever walks the tree at render
-- time, not something this type needs to represent.
type alias GraphicsElement =
    { id : Maybe Id   -- manual/stable naming only -- elements are related by
                       -- real data references internally (an Element value
                       -- held directly, e.g. in clipPath/mask/filter below),
                       -- never by id. SVG's own XML format still needs a
                       -- stable id + url(#id) pair for the *same*
                       -- relationship, though, so this is where a real
                       -- serializer synthesizes one for an Element that
                       -- turns out to be referenced from elsewhere, using
                       -- this field's value if the author set one
    -- transform (composes, doesn't inherit -- see module doc above)
    , transform : Transform
    -- paint (inherited)
    , fill : Maybe Paint
    , stroke : Maybe Paint
    , fillOpacity : Maybe Float
    , strokeOpacity : Maybe Float
    , opacity : Float   -- NOT inherited (compositing, not inheritance)
    , fillRule : Maybe FillRule
    -- stroke shape (inherited; only meaningful once `stroke` resolves to
    -- something other than `NoPaint`, but that's still true field-by-field
    -- here rather than grouped -- see the open TODO on modeling this as one
    -- `Maybe StrokeStyle` instead)
    , strokeWidth : Maybe Float
    , strokeLinecap : Maybe LineCap
    , strokeLinejoin : Maybe LineJoin
    , strokeDasharray : Maybe (List Float)
    , strokeDashoffset : Maybe Float
    , strokeMiterlimit : Maybe Float
    -- compositing (not inherited -- each applies per-element). clipPath/mask
    -- hold their own clipping/masking geometry directly as an Element (often
    -- a GroupElement wrapping several shapes) -- matches real SVG, where
    -- <clipPath>/<mask> both contain ordinary drawable content. `filter` is
    -- flagged as a rougher fit: real SVG <filter> contains filter
    -- *primitives* (feGaussianBlur, feOffset, ...), not drawable shapes, so
    -- reusing Element here is a simplification, not a faithful model, until
    -- a real filter-primitive type exists.
    , clipPath : Maybe Element
    , mask : Maybe Element
    , filter : Maybe Element
    , blendMode : BlendMode
    -- visibility ("visibility" is inherited; "display" is not)
    , visibility : Maybe Bool
    , display : Bool
    -- metadata (never inherited)
    , className : List String
    , title : Maybe String
    , desc : Maybe String
    }

-- The bundled constraint: "this record has at least every shared
-- graphics-element field." Not a concrete type on its own — every primitive
-- shape below satisfies it structurally by spreading the same
-- GraphicsElement fields plus its own geometry.
type alias IsGraphicsElement a = { a | ..GraphicsElement }

-- Row-polymorphic constraints, one per field, so a function can require just the
-- slice of IsGraphicsElement it actually touches instead of the whole bundle.

type alias HasId a = { a | id : Maybe Id }
type alias HasTransform a = { a | transform : Transform }

type alias HasFill a = { a | fill : Maybe Paint }
type alias HasStroke a = { a | stroke : Maybe Paint }
type alias HasFillOpacity a = { a | fillOpacity : Maybe Float }
type alias HasStrokeOpacity a = { a | strokeOpacity : Maybe Float }
type alias HasOpacity a = { a | opacity : Float }
type alias HasFillRule a = { a | fillRule : Maybe FillRule }

type alias HasStrokeWidth a = { a | strokeWidth : Maybe Float }
type alias HasStrokeLinecap a = { a | strokeLinecap : Maybe LineCap }
type alias HasStrokeLinejoin a = { a | strokeLinejoin : Maybe LineJoin }
type alias HasStrokeDasharray a = { a | strokeDasharray : Maybe (List Float) }
type alias HasStrokeDashoffset a = { a | strokeDashoffset : Maybe Float }
type alias HasStrokeMiterlimit a = { a | strokeMiterlimit : Maybe Float }

type alias HasClipPath a = { a | clipPath : Maybe Element }
type alias HasMask a = { a | mask : Maybe Element }
type alias HasFilter a = { a | filter : Maybe Element }
type alias HasBlendMode a = { a | blendMode : BlendMode }

type alias HasVisibility a = { a | visibility : Maybe Bool }
type alias HasDisplay a = { a | display : Bool }

type alias HasClassName a = { a | className : List String }
type alias HasTitle a = { a | title : Maybe String }
type alias HasDesc a = { a | desc : Maybe String }

type Paint
    = NoPaint
    | SolidColor Color
    -- Gradient or pattern. Same rougher-fit caveat as `filter` above: a real
    -- SVG <pattern> does contain drawable content (Element fits fine there),
    -- but <linearGradient>/<radialGradient> hold gradient stops, not
    -- shapes -- PaintServer doesn't exist as its own type yet to tell those
    -- apart, so this reuses Element for all of them for now.
    | PaintRef Element

type FillRule = NonZero | EvenOdd
type LineCap = Butt | RoundCap | Square
type LineJoin = Miter | RoundJoin | Bevel

type BlendMode
    = Normal | Multiply | Screen | Overlay | Darken | Lighten
    -- ...rest of the CSS blend modes, add as needed

type alias Transform = List TransformOp

type TransformOp
    = Translate Float Float
    | Scale Float Float
    | Rotate Float (Maybe (Float, Float))  -- angle, optional pivot
    | SkewX Float
    | SkewY Float

-- Primitive shapes ------------------------------------------------------
--
-- Each one spreads GraphicsElement's own fields (`..GraphicsElement`) plus
-- its own geometry. Because the field set is a superset, any of these
-- unifies fine wherever a function asks for `IsGraphicsElement a` or a
-- narrower `Has*`.

type alias Rect =
    { ..GraphicsElement
    -- geometry
    , x : Float
    , y : Float
    , width : Float
    , height : Float
    , rx : Maybe Float   -- corner rounding; Nothing = sharp corners
    , ry : Maybe Float
    }

type alias Circle =
    { ..GraphicsElement
    -- geometry
    , cx : Float
    , cy : Float
    , r : Float
    }

type alias Ellipse =
    { ..GraphicsElement
    -- geometry
    , cx : Float
    , cy : Float
    , rx : Float
    , ry : Float
    }

type alias Line =
    { ..GraphicsElement
    -- geometry
    , x1 : Float
    , y1 : Float
    , x2 : Float
    , y2 : Float
    }

type alias Point = { x : Float, y : Float }

type alias Polyline =
    { ..GraphicsElement
    -- geometry
    , points : List Point
    }

type alias Polygon =
    { ..GraphicsElement
    -- geometry
    , points : List Point
    }

-- Minimal path command set (see §"M/L/C/Z" discussion): every other SVG path
-- command (H/V/S/T/Q/A and their relative/lowercase forms) is either pure
-- shorthand for these or convertible to them, so this is all the internal
-- model needs to represent.
type PathCommand
    = MoveTo Float Float
    | LineTo Float Float
    | CurveTo Float Float Float Float Float Float   -- x1 y1 x2 y2 x y
    | ClosePath

type alias Path =
    { ..GraphicsElement
    -- geometry
    , d : List PathCommand
    }

-- The scene graph. Property inheritance now runs through Group (see
-- GraphicsElement's own doc comment): resolving a leaf shape's own
-- inherited fields (fill, strokeWidth, visibility, ...) means walking up
-- through every enclosing GroupElement until one sets the field (`Just _`)
-- or the walk runs out (fall back to the SVG-spec default) -- that
-- resolution logic isn't written yet, this is just the type shape it'll
-- walk. Element must be a closed sum type rather than `List (IsElement a)`
-- — IsElement a is a type-level function, and a List needs one concrete
-- element type shared by the whole list, so it can't hold a Circle and a
-- Rect side by side no matter what `a` is chosen; the usual ML fix for a
-- heterogeneous collection is a closed ADT enumerating the variants, same
-- pattern as PathCommand above.
type Element
    = CircleElement Circle
    | RectElement Rect
    | EllipseElement Ellipse
    | LineElement Line
    | PolylineElement Polyline
    | PolygonElement Polygon
    | PathElement Path
    | GroupElement Group

-- Now spreads GraphicsElement's full bundle rather than just `{ id,
-- children }` — that's what makes it the inheritance source in the first
-- place: a child resolves its own `Nothing` fields by looking at exactly
-- these fields on its nearest enclosing Group.
type alias Group =
    { ..GraphicsElement
    , children : List Element
    }

emptyGroup :: Group
emptpGroup = ?